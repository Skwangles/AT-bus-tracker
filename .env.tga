#!/bin/bash
# Note: There should be no space between <name> & '=' & <value> - e.g. FOO=bar,
# so this .env can be used for `source .env` and nodejs's dotEnv.config()

# General config used at multiple stages
export CV_OS=linux
export CV_HOME_DIR="/home/skwangles/Documents/Honours/CampusVirtual"
export CV_VIDEO_DIR="/media/skwangles/KINGSTON/MEDIA/TGA/video/"
export CV_JSON_DIR="/media/skwangles/KINGSTON/MEDIA/TGA/JSON/"
export CV_DB_DIR="/media/skwangles/KINGSTON/MEDIA/TGA/ReRun/MAPS/"

export CV_KEYFRAME_IMG_NAME_DP=5 # this is a hardcoded value
export CV_KEYFRAME_IMG_DIR="/media/skwangles/KINGSTON/MEDIA/TGA/ReRun/pictures/"
export CV_KEYFRAME_IMG_EXTENSION=".png"
export CV_COORDS_TO_METRES=15

# 1. Convert Raw files to Equirectangular
export CV_STITCH_INSV_FILES=false
export CV_STITCH_INSV_FILES_DIR=""
export CV_STITCH_RESOLUTION="5760x2880"

# 2. Map video with VSLAM
export CV_VSLAM_MAP_VIDEOS=false
export CV_VSLAM_EPOCH_START=100000 # starting offset for the image names
export CV_VSLAM_MAP_VIDEOS_COMMA_SEPARATED_NAMES="VID_20241219_095545_00_057.mp4,VID_20241219_115207_00_001.mp4"
export CV_VSLAM_MAP_HEADLESS=false
export CV_VSLAM_MAP_DIR="/media/skwangles/KINGSTON/MEDIA/TGA/ReRun/MAPS/"
export CV_VSLAM_MAP_NAME="tga-vslam.db"



# 3. Edit Loop closures (if any missed) (Recommend skipping unless later steps can't resolve issue)
export CV_EDIT_VSLAM_MAP=false
export CV_EDIT_VSLAM_OUTPUT_MAP_NAME="map-edited.db"

# 3. Convert VSLAM map to CV db
export CV_EXPORT_DB=false
export CV_EXPORT_IN_MAP_NAME="tga-vslam.db"
export CV_EXPORT_DB_NAME="tga.db"

# 4. Precalculate Images' laplacian sharpness 
export CV_PRECALCULATE_IMAGE_SHARPNESS=false
export CV_PRECALCULATE_IMAGE_SHARPNESS_JSON_PATH="/media/skwangles/KINGSTON/MEDIA/TGA/ReRun/JSON/sharpness.json"

# 5. Prune CV DB
export CV_GRAPH_PRUNE=false
export CV_PRUNE_USE_PRECALCULATED_IMAGE_SHARPNESS=true
export CV_PRUNE_TARGET_CLOSENESS=5
export CV_PRUNE_ALWAYS_MERGE_CLOSENESS=0.5
export CV_PRUNE_OUTDOORS_ALWAYS_MERGE_CLOSENESS=1
export CV_PRUNE_OUTDOORS_TARGET_CLOSENESS=7
export CV_PRUNE_OUTDOORS_Y_DIST_THRESHOLD=2
export CV_PRUNE_Y_DIST_THRESHOLD=2
export CV_PRUNE_OUTDOORS_LOCATION_NAME="outdoors"
export CV_PRUNE_TABLE_PREFIX="refined_"
export CV_PRUNE_USE_SQLITE=true
export CV_PRUNE_DB_NAME="tga.db"

# Merge maps
export CV_MERGE_MAPS=false
export CV_MERGE_1_NAME="tga.db"
export CV_MERGE_1_OVERWRITE_ZONE_NAME="Area2" # warning, this will overwrite all previously set zones in map 1
export CV_MERGE_2_NAME="zone2.db"
export CV_MERGE_2_ZONE="Area1"
export CV_MERGE_OUTPUT_NAME="output.db"

# 6. Copy images used in CV DB to new directory
export CV_EXTRACT_USED_IMAGES=false
export CV_EXTRACT_BATCH_SIZE=8
export CV_EXTRACT_USED_IMAGES_DIR="/media/skwangles/KINGSTON/MEDIA/TGA/ReRun/refined_pictures/"

# 7. View and edit CV DB
export CV_EDIT_DB_VISUALLY=false
export CV_EDIT_DB_NAME="tga.db"
export CV_EDIT_DB_TABLE_PREFIX="refined_" # use "" to look at unpruned tables, match GRAPH_PRUNE_TABLE_PREFIX to edit pruned 


# 8. Authoring - Should share the config with the server, so you are editing the same db/tables
export CV_START_AUTHORING=false
export CV_AUTHORING_PORT=3002
export CV_AUTHORING_DB_NAME="tga.db"
export CV_AUTHORING_USE_TABLE_PREFIX=true
export CV_AUTHORING_TABLE_PREFIX="refined_"
export CV_AUTHORING_ENABLE_AUTHORING_PAGE=false 
export CV_AUTHORING_DONT_OVERWRITE_MAP_POINTS=true

# strip out the restricted areas
export CV_STRIP_RESTRICTED_NODES=true
export CV_STRIP_INPUT_DB='tga.db'
export CV_STRIP_OUTPUT_DB='tga-pub.db'
export CV_STRIP_REMOVE='["4", "Level 4"]'
export CV_STRIP_KEEP_ID='[]'
export CV_STRIP_KEEP_LABELS='["save"]'

# 8. Run CampusVirtual viewer
export CV_START_SERVER=true
export CV_SERVER_PORT=3000
export CV_SERVER_USE_TABLE_PREFIX=true
export CV_SERVER_TABLE_PREFIX="refined_"
export CV_SERVER_DB_NAME="tga-pub.db"
export CV_SERVER_SEND_TEST_IMAGE=false
export CV_SERVER_FLOORPLAN_IMG_DIR="/media/skwangles/KINGSTON/MEDIA/TGA/ReRun/floorplans"

export CV_SERVER_NEIGHBOURS_INCLUDES_PROXIMITY=false
export CV_SERVER_ENABLE_AUTHORING_PAGE=false 
export CV_SERVER_DONT_OVERWRITE_MAP_POINTS=true