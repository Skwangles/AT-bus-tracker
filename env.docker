# Sitexplorer Docker Environment Variables

# Dataset configuration
DATASET_NAME=default

# Port configuration
WEB_UI_PORT=8080
AUTHORING_PORT=3002
FRONTEND_PORT=3001

# Database configuration
CV_SERVER_DB_NAME=campus.db
CV_AUTHORING_DB_NAME=campus.db

# File processing configuration
CV_STITCH_INSV_FILES=true
CV_STITCH_RESOLUTION=5760x2880

# SLAM configuration
CV_VSLAM_MAP_VIDEOS=true
CV_VSLAM_MAP_HEADLESS=true
CV_VSLAM_MAP_NAME=vslam.db
CV_VSLAM_EPOCH_START=2000000

# Database export configuration
CV_EXPORT_DB=true
CV_EXPORT_IN_MAP_NAME=vslam.db
CV_EXPORT_DB_NAME=campus.db

# Image sharpness calculation
CV_PRECALCULATE_IMAGE_SHARPNESS=false

# Graph pruning configuration
CV_GRAPH_PRUNE=true
CV_PRUNE_USE_PRECALCULATED_IMAGE_SHARPNESS=true
CV_PRUNE_TARGET_CLOSENESS=5
CV_PRUNE_ALWAYS_MERGE_CLOSENESS=0.5
CV_PRUNE_OUTDOORS_ALWAYS_MERGE_CLOSENESS=1
CV_PRUNE_OUTDOORS_TARGET_CLOSENESS=7
CV_PRUNE_OUTDOORS_Y_DIST_THRESHOLD=2
CV_PRUNE_Y_DIST_THRESHOLD=2
CV_PRUNE_OUTDOORS_LOCATION_NAME=outdoors
CV_PRUNE_TABLE_PREFIX=refined_
CV_PRUNE_USE_SQLITE=true
CV_PRUNE_DB_NAME=campus.db

# Map merging configuration
CV_MERGE_MAPS=false

# Image extraction configuration
CV_EXTRACT_USED_IMAGES=false
CV_EXTRACT_IN_DB_NAME=campus.db
CV_EXTRACT_TABLE_PREFIX=refined_
CV_EXTRACT_BATCH_SIZE=8

# Data initialization configuration
CV_INIT_DATA=true
CV_INIT_DONT_OVERWRITE_MAP_POINTS=true
CV_INIT_USE_TABLE_PREFIX=true
CV_INIT_TABLE_PREFIX=refined_

# Authoring configuration
CV_AUTHORING_USE_TABLE_PREFIX=true
CV_AUTHORING_TABLE_PREFIX=refined_

# Server configuration
CV_SERVER_USE_TABLE_PREFIX=true
CV_SERVER_TABLE_PREFIX=refined_
CV_SERVER_SEND_TEST_IMAGE=false
CV_SERVER_NEIGHBOURS_INCLUDES_PROXIMITY=false

# Restricted nodes configuration
CV_STRIP_RESTRICTED_NODES=false
CV_STRIP_INPUT_DB=campus.db
CV_STRIP_OUTPUT_DB=campus-pub.db
CV_STRIP_REMOVE='["4", "Level 4"]'
CV_STRIP_KEEP_ID='[]'
CV_STRIP_KEEP_LABELS='["save"]'
CV_STRIP_TABLE_PREFIX=refined_
