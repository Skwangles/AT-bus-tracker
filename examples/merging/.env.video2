#!/bin/bash
# Note: There should be no space between <name> & '=' & <value> - e.g. FOO=bar,
# so this .env can be used for `source .env` and nodejs's dotEnv.config()

# General config used at multiple stages
export CV_OS=linux
export CV_HOME_DIR="/home/skwangles/Documents/Honours/CampusVirtual/"
export CV_VIDEO_DIR="/media/skwangles/KINGSTON/MEDIA/RawINSV/Zones/Video/"
export CV_JSON_DIR="/media/skwangles/KINGSTON/MEDIA/RawINSV/Zones/JSON/"
export CV_VSLAM_MAP_DIR="/media/skwangles/KINGSTON/MEDIA/RawINSV/Zones/VSLAM_MAPS"
export CV_DB_DIR="/media/skwangles/KINGSTON/MEDIA/RawINSV/Zones/Maps/"

export CV_KEYFRAME_IMG_NAME_DP=5
export CV_KEYFRAME_IMG_DIR="/media/skwangles/KINGSTON/MEDIA/RawINSV/Zones/pictures/"
export CV_KEYFRAME_IMG_EXTENSION=".png"
export CV_COORDS_TO_METRES=10;

# 1. Convert Raw files to Equirectangular
export CV_STITCH_INSV_FILES=false
export CV_STITCH_INSV_FILES_DIR=""
export CV_STITCH_RESOLUTION="5760x2880"

# 2. Map video with VSLAM
export CV_VSLAM_MAP_VIDEOS=true
export CV_VSLAM_EPOCH_START=2000000 # starting offset for the image names
export CV_VSLAM_MAP_VIDEOS_COMMA_SEPARATED_NAMES="VID_20241213_154153_00_055.mp4"
export CV_VSLAM_MAP_HEADLESS=false
export CV_VSLAM_MAP_NAME="vslam-zone-2.db"

# 3. Edit Loop closures (if any missed) (Recommend skipping unless later steps can't resolve issue)
export CV_EDIT_VSLAM_MAP=false
export CV_EDIT_VSLAM_OUTPUT_MAP_NAME="map-edited-2.db"

# 3. Convert VSLAM map to CV db
export CV_EXPORT_DB=true
export CV_EXPORT_IN_MAP_NAME="vslam-zone-2.db"
export CV_EXPORT_DB_NAME="zone-2.db"

# 4. Precalculate Images' laplacian sharpness 
export CV_PRECALCULATE_IMAGE_SHARPNESS=true
export CV_PRECALCULATE_IMAGE_SHARPNESS_JSON_PATH="/media/skwangles/KINGSTON/MEDIA/RawINSV/Zones/JSON/zone-2.json"

# 5. Prune CV DB
export CV_GRAPH_PRUNE=true
export CV_PRUNE_USE_PRECALCULATED_IMAGE_SHARPNESS=true
export CV_PRUNE_TARGET_CLOSENESS=5;
export CV_PRUNE_ALWAYS_MERGE_CLOSENESS=0.5;
export CV_PRUNE_OUTDOORS_ALWAYS_MERGE_CLOSENESS=1;
export CV_PRUNE_OUTDOORS_TARGET_CLOSENESS=7;
export CV_PRUNE_OUTDOORS_Y_DIST_THRESHOLD=2;
export CV_PRUNE_Y_DIST_THRESHOLD=2;
export CV_PRUNE_OUTDOORS_LOCATION_NAME="outdoors";
export CV_PRUNE_TABLE_PREFIX="refined_";
export CV_PRUNE_USE_SQLITE=true;
export CV_PRUNE_DB_NAME="zone-2.db";

export CV_MERGE_MAPS=false
export CV_MERGE_1_NAME="zone-1.db"
export CV_MERGE_1_OVERWRITE_ZONE_NAME="zone-1" # warning, this will overwrite all previously set zones in map 1
export CV_MERGE_2_NAME="zone-2.db"
export CV_MERGE_2_ZONE="zone-2"
export CV_MERGE_OUTPUT_NAME="output.db"
export CV_MERGE_OVERWRITE_EXISTING_OUTPUT=true # If true, will overwrite the output file if it already exists

# 6. Copy images used in CV DB to new directory
export CV_EXTRACT_USED_IMAGES=true
export CV_EXTRACT_BATCH_SIZE=8
export CV_EXTRACT_USED_IMAGES_DIR="/media/skwangles/KINGSTON/MEDIA/RawINSV/Zones/refined_pictures/"

# 7. View and edit CV DB
export CV_EDIT_DB_VISUALLY=true
export CV_EDIT_DB_NAME="output.db" 
export CV_EDIT_DB_TABLE_PREFIX="refined_" # use "" to look at unpruned tables, match GRAPH_PRUNE_TABLE_PREFIX to edit pruned 

# 8. Run CampusVirtual viewer
export CV_START_SERVER=false

export CV_SERVER_USE_TABLE_PREFIX=true
export CV_SERVER_TABLE_PREFIX="refined_"
export CV_SERVER_DB_NAME="output.db"
export CV_SERVER_SEND_TEST_IMAGE=false
export CV_SERVER_FLOORPLAN_IMG_DIR="/media/skwangles/KINGSTON/MEDIA/RawINSV/Zones/floorplans/"

export CV_SERVER_NEIGHBOURS_INCLUDES_PROXIMITY=false
export CV_SERVER_ENABLE_AUTHORING_PAGE=false 
export CV_SERVER_DONT_OVERWRITE_MAP_POINTS=false