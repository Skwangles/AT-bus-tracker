#!/bin/bash
# Note: There should be no space between <name> & '=' & <value> - e.g. FOO=bar,
# so this .env can be used for `source .env` and nodejs's dotEnv.config()

# General config used at multiple stages
export CV_VIDEO_DIR="/media/skwangles/KINGSTON/TGA - Out/video/"
export CV_JSON_DIR="/media/skwangles/KINGSTON/TGA - Out/JSON/"
export CV_DB_DIR="/media/skwangles/KINGSTON/TGA - Out/MAPS/"

export CV_KEYFRAME_IMG_NAME_DP=5
export CV_KEYFRAME_IMG_DIR="/media/skwangles/KINGSTON/TGA - Out/pictures/"
export CV_KEYFRAME_IMG_EXTENSION=".png"
export CV_COORDS_TO_METRES=10;

# 1. Convert Raw files to Equirectangular
export CV_STITCH_INSV_FILES=true
export CV_STITCH_INSV_FILES_DIR=""
export CV_STITCH_RESOLUTION="5760x2880"

# 2. Map video with VSLAM
export CV_VSLAM_MAP_VIDEOS=true
export CV_VSLAM_EPOCH_START=0 # starting offset for the image names
export CV_VSLAM_MAP_VIDEOS_COMMA_SEPARATED_NAMES="video1.mp4,video2.mp4" # Put as many videos as you want in here
export CV_VSLAM_MAP_HEADLESS=false
export CV_VSLAM_MAP_DIR="/media/skwangles/KINGSTON/TGA - Out/MAPS/"
export CV_VSLAM_MAP_NAME="vslam-map.db" # Name of the output map



# 3. Edit Loop closures (if any missed) (Recommend skipping unless later steps can't resolve issue)
export CV_EDIT_VSLAM_MAP=true
export CV_EDIT_VSLAM_OUTPUT_MAP_NAME="map-edited.db"

# 3. Convert VSLAM map to CV db
export CV_EXPORT_DB=true
export CV_EXPORT_IN_MAP_NAME="vslam-map.db"
export CV_EXPORT_DB_NAME="cv.db"

# 4. Precalculate Images' laplacian sharpness 
export CV_PRECALCULATE_IMAGE_SHARPNESS=true
export CV_PRECALCULATE_IMAGE_SHARPNESS_JSON_PATH="/media/skwangles/KINGSTON/TGA - Out/JSON/sharpness.json"

# 5. Prune CV DB
export CV_GRAPH_PRUNE=true
export CV_PRUNE_USE_PRECALCULATED_IMAGE_SHARPNESS=true
export CV_PRUNE_TARGET_CLOSENESS=5;
export CV_PRUNE_ALWAYS_MERGE_CLOSENESS=0.5;
export CV_PRUNE_OUTDOORS_ALWAYS_MERGE_CLOSENESS=1;
export CV_PRUNE_OUTDOORS_TARGET_CLOSENESS=7;
export CV_PRUNE_OUTDOORS_Y_DIST_THRESHOLD=2;
export CV_PRUNE_Y_DIST_THRESHOLD=2;
export CV_PRUNE_OUTDOORS_LOCATION_NAME="outdoors";
export CV_PRUNE_TABLE_PREFIX="refined_";
export CV_PRUNE_DB_NAME="tga-building.db"; # DB is modified in place by copying the tables with the TABLE_PREFIX prepended on the table names (e.g. refined_table_name)


export CV_MERGE_MAPS=false
export CV_MERGE_1_NAME="tga-building.db"
export CV_MERGE_1_OVERWRITE_ZONE_NAME="Area2" # warning, this will overwrite all previously set zones in map 1 - Use this if the map hasn't been merged before
export CV_MERGE_2_NAME="zone2.db"
export CV_MERGE_2_ZONE="Area1"
export CV_MERGE_OUTPUT_NAME="output.db"
export CV_MERGE_OVERWRITE_EXISTING_OUTPUT=false # If true, will overwrite the output file if it already exists

# 6. Copy images used in CV DB to new directory
export CV_EXTRACT_USED_IMAGES=true
export CV_EXTRACT_BATCH_SIZE=5
export CV_EXTRACT_USED_IMAGES_DIR="/media/skwangles/KINGSTON/TGA - Out/refined_pictures/"

# 7. View and edit CV DB
export CV_EDIT_DB_VISUALLY=true
export CV_EDIT_DB_NAME="cv.db" # db is modified in place
export CV_EDIT_DB_TABLE_PREFIX="refined_" # use "" to look at unpruned tables, match GRAPH_PRUNE_TABLE_PREFIX to edit pruned 


# 8. Run CampusVirtual viewer
export CV_START_SERVER=true

CV_SERVER_PORT=3000
CV_SERVER_USE_TABLE_PREFIX=true
CV_SERVER_TABLE_PREFIX="refined_"
CV_SERVER_DB_NAME="cv.db"
CV_SERVER_SEND_TEST_IMAGE=false
CV_SERVER_FLOORPLAN_IMG_DIR="/home/skwangles/Documents/Honours/CampusVirtual/floorplans/"

CV_SERVER_NEIGHBOURS_INCLUDES_PROXIMITY=false
CV_SERVER_ENABLE_AUTHORING_PAGE=false 
CV_SERVER_DONT_OVERWRITE_MAP_POINTS=false