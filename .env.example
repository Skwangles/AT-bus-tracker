#!/bin/bash
# Note: There should be no space between <name> & '=' & <value> - e.g. FOO=bar,
# so this .env can be used for `source .env` and nodejs's dotEnv.config()

# General config used at multiple stages
CV_OS=linux
CV_HOME_DIR="/home/skwangles/Documents/Honours/CampusVirtual"
CV_VIDEO_DIR="/media/skwangles/KINGSTON/TGA - Out/video/"
CV_JSON_DIR="/media/skwangles/KINGSTON/TGA - Out/JSON/"
CV_DB_DIR="/media/skwangles/KINGSTON/TGA - Out/MAPS/"

CV_KEYFRAME_IMG_NAME_DP=5
CV_KEYFRAME_IMG_DIR="/media/skwangles/KINGSTON/TGA - Out/pictures/"
CV_KEYFRAME_IMG_EXTENSION=".png"
CV_COORDS_TO_METRES=10;

# 1. Convert Raw files to Equirectangular
CV_STITCH_INSV_FILES=true
CV_STITCH_INSV_FILES_DIR=""
CV_STITCH_RESOLUTION="5760x2880"

# 2. Map video with VSLAM
CV_VSLAM_MAP_VIDEOS=true
CV_VSLAM_MAP_VIDEOS_COMMA_SEPARATED_NAMES="video1.mp4,video2.mp4"
CV_VSLAM_MAP_HEADLESS=false
CV_VSLAM_MAP_DIR="/media/skwangles/KINGSTON/TGA - Out/MAPS/"
CV_VSLAM_MAP_NAME="vslam-map.db"



# 3. Edit Loop closures (if any missed) (Recommend skipping unless later steps can't resolve issue)
CV_EDIT_VSLAM_MAP=true
CV_EDIT_VSLAM_OUTPUT_MAP_NAME="map-edited.db"

# 3. Convert VSLAM map to CV db
CV_EXPORT_DB=true
CV_EXPORT_DB_NAME="cv.db"

# 4. Precalculate Images' laplacian sharpness 
CV_PRECALCULATE_IMAGE_SHARPNESS=true
CV_PRECALCULATE_IMAGE_SHARPNESS_JSON_PATH="/media/skwangles/KINGSTON/TGA - Out/JSON/sharpness.json"

# 5. Prune CV DB
CV_GRAPH_PRUNE=true
CV_PRUNE_USE_PRECALCULATED_IMAGE_SHARPNESS=true
CV_PRUNE_TARGET_CLOSENESS=5;
CV_PRUNE_ALWAYS_MERGE_CLOSENESS=0.5;
CV_PRUNE_OUTDOORS_ALWAYS_MERGE_CLOSENESS=1;
CV_PRUNE_OUTDOORS_TARGET_CLOSENESS=7;
CV_PRUNE_OUTDOORS_Y_DIST_THRESHOLD=2;
CV_PRUNE_Y_DIST_THRESHOLD=2;
CV_PRUNE_KEYFRAME_IMG_EXTENSION=".png";
CV_PRUNE_KEYFRAME_IMG_DIR="/media/skwangles/KINGSTON/TGA - Out/pictures/";
CV_PRUNE_OUTDOORS_LOCATION_NAME="outdoors";
CV_PRUNE_TABLE_PREFIX="refined_";
CV_PRUNE_USE_SQLITE=true;
CV_PRUNE_SQLITE_DB_PATH="/media/skwangles/KINGSTON/TGA - Out/MAPS/tga-building.db";

# 6. Copy images used in CV DB to new directory
CV_EXTRACT_USED_IMAGES=true
CV_EXTRACT_BATCH_SIZE=5
CV_EXTRACT_USED_IMAGES_DIR="/media/skwangles/KINGSTON/TGA - Out/refined_pictures/"

# 7. View and edit CV DB
CV_EDIT_DB_VISUALLY=true
CV_EDIT_DB_TABLE_PREFIX="refined_" # use "" to look at unpruned tables, match GRAPH_PRUNE_TABLE_PREFIX to edit pruned 


# 8. Run CampusVirtual viewer
CV_START_SERVER=true

CV_SERVER_USE_TABLE_PREFIX=true
CV_SERVER_TABLE_PREFIX="refined_"
CV_SERVER_DB_NAME="cv.db"
CV_SERVER_SEND_TEST_IMAGE=false
CV_SERVER_FLOORPLAN_IMG_DIR="/home/skwangles/Documents/Honours/CampusVirtual/floorplans/"

CV_SERVER_NEIGHBOURS_INCLUDES_PROXIMITY=false
CV_SERVER_ENABLE_AUTHORING_PAGE=false 
CV_SERVER_DONT_OVERWRITE_MAP_POINTS=false